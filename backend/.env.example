# MongoDB connection string. Must point at a replica set so multi-document
# ACID transactions (used for transfers and registration) are available.
# For local dev, run mongod with --replSet rs0 and run rs.initiate() once,
# or use a Docker image preconfigured as a single-node replica set.
MONGO_URI=mongodb://127.0.0.1:27017/mybanking?replicaSet=rs0

# Secret used to sign and verify JWTs. Required. Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-secret

# JWT lifetime in seconds. Defaults to 3600 (1 hour) if omitted.
JWT_EXPIRES_IN=3600

# Port the HTTP server listens on.
PORT=5000

# Comma-separated list of allowed CORS origins.
CORS_ALLOWLIST=http://localhost:3000,http://localhost:5173

# bcrypt cost factor (number of hashing rounds).
BCRYPT_ROUNDS=12
